.{
    .name = .zenfmt,
    .version = "0.1.0",
    .fingerprint = 0x5a31e05440876fc1, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{},
    // Consumers use the umbrella `zenfmt` module rooted at src/root.zig, or
    // compose a smaller bundle from `zenfmt_core` and the format libraries.
    // The docs, tools, and cross-module tests stay repository-only.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "README.md",
        "LICENSE",
        "core",
        "support",
        "formats",
        "src",
        "cli",
        "bindings",
        "python",
        "pyproject.toml",
        "hatch_build.py",
        "uv.lock",
    },
}
